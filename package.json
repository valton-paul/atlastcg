{
  "name": "atlas",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "content:check": "tsx scripts/build-content.ts --check",
    "content:build": "tsx scripts/build-content.ts",
    "map:build": "tsx scripts/build-world-map.ts",
    "test": "jest --selectProjects app content",
    "test:db": "jest --selectProjects db --runInBand",
    "test:all": "jest --runInBand",
    "verify": "npm run lint && npm run typecheck && npm run content:check && npm run test:all",
    "export:android": "expo export --platform android --output-dir dist-android"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.3",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/d3-geo": "^3.1.1",
    "@types/jest": "30.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.3.0",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "world-atlas": "^2.0.2"
  }
}
