# Valeurs PUBLIQUES du projet Supabase (Project Settings > API).
# Elles sont intégrées à l'application : n'y mettez jamais de clé secrète ni service_role.
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_PUBLIC_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Les variables EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY sont aussi acceptées.
# Une clé secrète éventuelle (SUPABASE_SECRET_KEY) n'est jamais lue par app.config.ts.

# Origine utilisée dans les liens e-mail (confirmation, reset). En local : http://localhost:8081
# EXPO_PUBLIC_APP_URL=http://localhost:8081
